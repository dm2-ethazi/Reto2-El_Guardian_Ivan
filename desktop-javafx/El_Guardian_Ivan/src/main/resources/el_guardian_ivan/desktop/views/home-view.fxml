<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de inicio: portada azul noche con dos tarjetas de acceso, como en el boceto -->
<VBox styleClass="hero" alignment="CENTER" spacing="14.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="el_guardian_ivan.desktop.controller.HomeController">

    <Label text="%app.title" styleClass="hero-title"/>
    <Label text="%home.subtitle" styleClass="hero-subtitle"/>
    <Label text="%home.text"
           wrapText="true" maxWidth="460.0" styleClass="hero-text"/>

    <HBox alignment="CENTER" spacing="24.0" styleClass="hero-cards">
        <Button styleClass="card" onAction="#onOpenEncrypt" prefWidth="250.0" prefHeight="170.0"
                accessibleText="%home.encrypt.accessible">
            <graphic>
                <VBox alignment="CENTER" spacing="8.0">
                    <Region styleClass="icon,card-icon,icon-lock"/>
                    <Label text="%home.encrypt.title" styleClass="card-title"/>
                    <Label text="%home.encrypt.text" wrapText="true" styleClass="card-text"/>
                </VBox>
            </graphic>
        </Button>
        <Button styleClass="card" onAction="#onOpenDecrypt" prefWidth="250.0" prefHeight="170.0"
                accessibleText="%home.decrypt.accessible">
            <graphic>
                <VBox alignment="CENTER" spacing="8.0">
                    <Region styleClass="icon,card-icon,icon-lock-open"/>
                    <Label text="%home.decrypt.title" styleClass="card-title"/>
                    <Label text="%home.decrypt.text" wrapText="true" styleClass="card-text"/>
                </VBox>
            </graphic>
        </Button>
    </HBox>

    <HBox alignment="CENTER" spacing="8.0" styleClass="hero-footer">
        <Region styleClass="icon,icon-info"/>
        <Label text="%home.hint" styleClass="hero-text"/>
    </HBox>
</VBox>
