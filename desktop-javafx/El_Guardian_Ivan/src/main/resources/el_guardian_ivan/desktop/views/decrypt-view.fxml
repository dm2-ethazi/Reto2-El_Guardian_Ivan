<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="el_guardian_ivan.desktop.controller.DecryptController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="Descifrar archivo"/>
    <Label text="Selecciona un archivo .hgw e introduce la contraseña para recuperarlo." wrapText="true"/>

    <Label text="1. Seleccionar archivo .hgw"/>
    <Button fx:id="selectButton" text="Examinar..." onAction="#onSelectInputFile"/>
    <Label fx:id="inputFileLabel" text="Ningún fichero seleccionado" wrapText="true"/>

    <Label text="2. Introducir contraseña"/>
    <PasswordField fx:id="passwordField"/>

    <Label text="3. Archivo de salida: se elige al pulsar el botón"/>
    <Button fx:id="runButton" text="Descifrar archivo..." onAction="#onDecrypt"/>

    <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
    <Label fx:id="statusLabel"/>
</VBox>
