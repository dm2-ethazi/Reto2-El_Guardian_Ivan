<?xml version='1.0' encoding='utf-8'?>
<!-- Vista propia para móviles en horizontal: dos paneles independientes,
     sin imágenes de pergamino estiradas ni botones debajo de la barra inferior. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/midnight" android:orientation="vertical" tools:context=".ui.CesarActivity">

    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="match_parent" android:contentDescription="@string/back" android:gravity="center" android:text="‹" android:textColor="@color/gold" android:textSize="34sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif" android:gravity="center" android:text="@string/action_cesar" android:textColor="@color/gold" android:textSize="22sp" android:textStyle="bold"/>
        <Space android:layout_width="48dp" android:layout_height="match_parent"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp" android:baselineAligned="false">

        <!-- Columna de entrada: se desplaza sin mover el resultado. -->
        <ScrollView android:id="@+id/scroll_cesar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/bg_land_panel" android:fillViewport="false" android:overScrollMode="never" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="35dp" android:layout_height="35dp" android:contentDescription="@null" android:src="@drawable/icon_cesar"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:text="@string/cesar_description" android:textColor="@color/ink" android:textSize="13sp" android:maxLines="3"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="serif" android:text="@string/file_txt" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_file" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp" android:minHeight="58dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:contentDescription="@null" android:src="@drawable/icon_archivo"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:orientation="vertical">
                        <TextView android:id="@+id/selected_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/file_placeholder" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold" android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:paddingTop="2dp"/>
                        <TextView android:id="@+id/file_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TXT · UTF-8" android:textColor="#82664B" android:textSize="10sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/btn_browse" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/bg_teal_button" android:clickable="true" android:contentDescription="@string/browse" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="@string/browse" android:textColor="@color/ivory" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="serif" android:text="@string/shift" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
                <EditText android:id="@+id/input_shift" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:contentDescription="@string/shift" android:inputType="numberSigned" android:maxLines="1" android:paddingHorizontal="12dp" android:text="3" android:textColor="@color/ink" android:textSize="16sp"/>
            </LinearLayout>
        </ScrollView>

        <!-- Columna del resultado: el texto es desplazable y las acciones accesibles. -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_land_panel" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/decrypted_text" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/result_text" android:saveEnabled="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:gravity="top|start" android:padding="10dp" android:scrollbars="vertical" android:fadeScrollbars="false" android:text="@string/result_placeholder" android:textColor="@color/ink" android:textIsSelectable="false" android:textSize="13sp"/>
            <LinearLayout android:id="@+id/btn_decrypt" android:layout_width="match_parent" android:layout_height="43dp" android:layout_marginTop="7dp" android:background="@drawable/bg_burgundy_button" android:clickable="true" android:contentDescription="@string/decipher_cesar" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:contentDescription="@null" android:src="@drawable/icon_varita"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/decipher_cesar" android:textColor="@color/ivory" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/btn_share_text" android:layout_width="match_parent" android:layout_height="37dp" android:layout_marginTop="5dp" android:background="@drawable/bg_outline_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/share_text" android:textColor="@color/ink" android:textSize="13sp" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
