<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/midnight" android:orientation="vertical" tools:context=".ui.AesActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="match_parent" android:contentDescription="@string/back" android:gravity="center" android:text="‹" android:textColor="@color/gold" android:textSize="34sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif" android:gravity="center" android:text="@string/action_aes" android:textColor="@color/gold" android:textSize="22sp" android:textStyle="bold"/>
        <Space android:layout_width="48dp" android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
        <!-- Entrada a la izquierda: independiente y desplazable incluso con el teclado. -->
        <ScrollView android:id="@+id/scroll_aes" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/bg_land_panel" android:fillViewport="false" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="35dp" android:layout_height="35dp" android:contentDescription="@null" android:src="@drawable/icon_paisaje_teal"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:maxLines="3" android:text="@string/aes_description" android:textColor="@color/ink" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="serif" android:text="@string/file_hgw" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_file" android:gravity="center_vertical" android:orientation="horizontal" android:padding="6dp" android:minHeight="58dp">
                    <ImageView android:layout_width="25dp" android:layout_height="25dp" android:contentDescription="@null" android:src="@drawable/icon_archivo_verde"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/selected_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/file_placeholder" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold" android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:paddingTop="2dp"/>
                        <TextView android:id="@+id/file_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HOG2 · AES-256-GCM" android:textColor="#82664B" android:textSize="10sp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/btn_browse" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/bg_teal_button" android:clickable="true" android:contentDescription="@string/browse" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="@string/browse" android:textColor="@color/ivory" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="serif" android:text="@string/password_prompt" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" android:singleLine="false" android:breakStrategy="high_quality" android:paddingBottom="2dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/input_password" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="@string/password_hint" android:inputType="textPassword" android:maxLines="1" android:paddingHorizontal="12dp" android:textColor="@color/ink" android:textColorHint="#806652" android:textSize="15sp"/>
                    <ImageView android:id="@+id/btn_show_password" android:layout_width="44dp" android:layout_height="match_parent" android:clickable="true" android:contentDescription="@string/toggle_password" android:focusable="true" android:padding="10dp" android:src="@drawable/ic_eye_closed" android:tint="@color/ink"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <!-- Acciones a la derecha, con el boton siempre visible junto al borde inferior. -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/bg_land_panel" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="serif" android:text="@string/decipher_aes" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/aes_hint" android:textColor="@color/ink" android:textSize="12sp"/>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:indeterminate="true" android:indeterminateTint="@color/burgundy" android:visibility="gone"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="@color/ink" android:textSize="12sp" android:visibility="gone"/>
            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <LinearLayout android:id="@+id/btn_decrypt" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="7dp" android:background="@drawable/bg_teal_button" android:clickable="true" android:contentDescription="@string/decipher_aes" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:contentDescription="@null" android:src="@drawable/icon_candado"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/decipher_aes" android:textColor="@color/ivory" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
