<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/midnight" android:orientation="vertical" tools:context=".ui.ResultActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
        android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="match_parent"
            android:contentDescription="@string/back" android:gravity="center" android:text="‹"
            android:textColor="@color/gold" android:textSize="34sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="serif" android:gravity="center" android:text="@string/result_title"
            android:textColor="@color/gold" android:textSize="22sp" android:textStyle="bold" />
        <Space android:layout_width="48dp" android:layout_height="match_parent" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:baselineAligned="false"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
        <!-- Vista previa: escala FIT_CENTER, no se estira ni tapa el marco. -->
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.3" android:layout_marginEnd="5dp"
            android:background="@drawable/bg_land_panel" android:orientation="vertical"
            android:padding="11dp">
            <ImageView android:id="@+id/image_preview" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_file"
                android:contentDescription="@string/recovered_image_accessibility" android:padding="4dp"
                android:adjustViewBounds="false" android:scaleType="fitCenter" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical">
                <TextView android:id="@+id/result_filename" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:ellipsize="middle" android:maxLines="1"
                    android:text="imagen.png" android:textColor="@color/ink" android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView android:id="@+id/result_size" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/recovered_image"
                    android:textColor="#765B46" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <!-- Los controles pueden desplazarse si el telefono es muy bajo en horizontal. -->
        <ScrollView android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="5dp"
            android:background="@drawable/bg_land_panel" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="serif" android:text="@string/result_success" android:textColor="@color/ink"
                    android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/btn_view" android:layout_width="match_parent" android:layout_height="42dp"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_green_button"
                    android:clickable="true" android:contentDescription="@string/view_image" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:text="@string/view_image" android:textColor="@color/ivory" android:textSize="15sp" />
                <TextView android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="42dp"
                    android:layout_marginTop="7dp" android:background="@drawable/bg_outline_button"
                    android:clickable="true" android:contentDescription="@string/save" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:text="@string/save" android:textColor="@color/ink" android:textSize="15sp" />
                <TextView android:id="@+id/btn_share" android:layout_width="match_parent" android:layout_height="42dp"
                    android:layout_marginTop="7dp" android:background="@drawable/bg_outline_button"
                    android:clickable="true" android:contentDescription="@string/share" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" android:gravity="center"
                    android:text="@string/share" android:textColor="@color/ink" android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
