<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/midnight" android:orientation="vertical" tools:context=".ui.AesActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btn_back" android:layout_width="56dp" android:layout_height="match_parent" android:contentDescription="@string/back" android:gravity="center" android:text="‹" android:textColor="@color/gold" android:textSize="40sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif" android:gravity="center" android:text="@string/action_aes" android:textColor="@color/gold" android:textSize="26sp" android:textStyle="bold"/>
        <Space android:layout_width="56dp" android:layout_height="match_parent"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_margin="7dp" android:layout_weight="1" android:background="@drawable/fondo_pergamino" android:clipChildren="true" android:clipToPadding="true"><ScrollView android:fillViewport="false" android:overScrollMode="never" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="32dp" android:layout_marginBottom="34dp" android:clipToPadding="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="0dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="10dp" android:paddingBottom="26dp">
            <ImageView android:layout_width="76dp" android:layout_height="76dp" android:contentDescription="@string/action_aes" android:src="@drawable/icon_paisaje_teal"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/aes_description" android:textColor="@color/ink" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="──────── ✦ ────────" android:textColor="#AE7D38" android:textSize="17sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:fontFamily="serif" android:text="@string/file_hgw" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_file" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:minHeight="72dp">
                <ImageView android:layout_width="35dp" android:layout_height="35dp" android:contentDescription="@null" android:src="@drawable/icon_archivo_verde"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/selected_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/file_placeholder" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold" android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:paddingTop="2dp"/>
                    <TextView android:id="@+id/file_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOG2 · AES-256-GCM" android:textColor="#82664B" android:textSize="11sp"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_browse" android:layout_width="90dp" android:layout_height="44dp" android:background="@drawable/bg_teal_button" android:clickable="true" android:contentDescription="@string/browse" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="@string/browse" android:textColor="@color/ivory" android:textSize="14sp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="─────── ✦ ───────" android:textColor="#AE7D38"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="serif" android:text="@string/password_prompt" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" android:singleLine="false" android:breakStrategy="high_quality" android:paddingBottom="2dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:orientation="horizontal">
                <EditText android:id="@+id/input_password" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="@string/password_hint" android:inputType="textPassword" android:maxLines="1" android:paddingHorizontal="12dp" android:textColor="@color/ink" android:textColorHint="#806652" android:textSize="16sp" android:saveEnabled="true"/>
                <ImageView android:id="@+id/btn_show_password" android:layout_width="48dp" android:layout_height="match_parent" android:clickable="true" android:contentDescription="@string/toggle_password" android:focusable="true" android:padding="12dp" android:src="@drawable/ic_eye_closed" android:tint="@color/ink"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_file" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
                <ImageView android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@null" android:src="@drawable/icon_info"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:text="@string/aes_hint" android:textColor="@color/ink" android:textSize="13sp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="18dp" android:indeterminate="true" android:indeterminateTint="@color/burgundy" android:visibility="gone"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="" android:textColor="@color/ink" android:textSize="13sp" android:visibility="gone"/>
            <Space android:layout_width="match_parent" android:layout_height="6dp"/>
            <LinearLayout android:id="@+id/btn_decrypt" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_teal_button" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal" android:contentDescription="@string/decipher_aes">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="8dp" android:src="@drawable/icon_candado" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/decipher_aes" android:textColor="@color/ivory" android:textSize="17sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </FrameLayout><include layout="@layout/view_bottom_nav"/>
</LinearLayout>
