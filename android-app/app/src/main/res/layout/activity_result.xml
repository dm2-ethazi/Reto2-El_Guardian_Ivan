<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/midnight" android:orientation="vertical" tools:context=".ui.ResultActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btn_back" android:layout_width="56dp" android:layout_height="match_parent" android:contentDescription="@string/back" android:gravity="center" android:text="‹" android:textColor="@color/gold" android:textSize="40sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif" android:gravity="center" android:text="@string/result_title" android:textColor="@color/gold" android:textSize="26sp" android:textStyle="bold"/>
        <Space android:layout_width="56dp" android:layout_height="match_parent"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_margin="7dp" android:layout_weight="1" android:background="@drawable/fondo_pergamino" android:clipChildren="true" android:clipToPadding="true"><ScrollView android:fillViewport="false" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="32dp" android:layout_marginBottom="34dp" android:overScrollMode="never" android:clipToPadding="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="0dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="10dp" android:paddingBottom="26dp">
            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:contentDescription="@null" android:src="@drawable/icon_exito"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="serif" android:gravity="center" android:text="@string/result_success" android:textColor="@color/ink" android:textSize="23sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="─────── ✦ ───────" android:textColor="#AE7D38"/>
            <ImageView android:id="@+id/image_preview" android:layout_width="match_parent" android:layout_height="245dp" android:layout_marginTop="14dp" android:adjustViewBounds="false" android:background="@drawable/bg_file" android:contentDescription="@string/recovered_image_accessibility" android:padding="3dp" android:scaleType="fitCenter"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@null" android:src="@drawable/icon_archivo_verde"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/result_filename" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="imagen.png" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/result_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/recovered_image" android:textColor="#765B46" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/btn_view" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_green_button" android:clickable="true" android:contentDescription="@string/view_image" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="10dp" android:src="@drawable/icon_paisaje_dorado" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/view_image" android:textColor="@color/ivory" android:textSize="16sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btn_save" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_outline_button" android:clickable="true" android:contentDescription="@string/save" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="10dp" android:src="@drawable/icon_archivo_verde" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/save" android:textColor="@color/ink" android:textSize="16sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btn_share" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_outline_button" android:clickable="true" android:contentDescription="@string/share" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_marginEnd="10dp" android:src="@drawable/icon_compartir" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/share" android:textColor="@color/ink" android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </FrameLayout><include layout="@layout/view_bottom_nav"/>
</LinearLayout>
