<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight"
    tools:context=".ui.MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_castillo" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingTop="25dp"
                android:paddingRight="18dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="206dp"
                    android:layout_height="165dp"
                    android:contentDescription="@string/logo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/guardian_logo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:shadowColor="#99000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="@string/title_home"
                    android:textColor="@color/gold"
                    android:textSize="29sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/subtitle_home"
                    android:textColor="@color/ivory"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="56dp" />

                <LinearLayout
                    android:id="@+id/card_cesar"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_burgundy_button"
                    android:clickable="true"
                    android:contentDescription="@string/open_cesar"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:src="@drawable/icon_cesar"
                        android:contentDescription="@null" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="@string/action_cesar"
                            android:textColor="@color/gold"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_cesar_caption"
                            android:textColor="@color/ivory"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/gold"
                        android:textSize="32sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_aes"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_teal_button"
                    android:clickable="true"
                    android:contentDescription="@string/open_aes"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:src="@drawable/icon_paisaje_teal"
                        android:contentDescription="@null" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="@string/action_aes"
                            android:textColor="@color/gold"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_aes_caption"
                            android:textColor="@color/ivory"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/gold"
                        android:textSize="32sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/view_bottom_nav" />
    </LinearLayout>
    <ImageView
        android:id="@+id/top_settings"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:padding="9dp"
        android:src="@drawable/icon_ajustes_activo"
        android:contentDescription="@string/nav_settings"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless" />
</FrameLayout>
