<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/midnight" android:orientation="vertical" tools:context=".ui.CesarActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/bg_header" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btn_back" android:layout_width="56dp" android:layout_height="match_parent" android:contentDescription="@string/back" android:gravity="center" android:text="‹" android:textColor="@color/gold" android:textSize="40sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="serif" android:gravity="center" android:text="@string/action_cesar" android:textColor="@color/gold" android:textSize="26sp" android:textStyle="bold"/>
        <Space android:layout_width="56dp" android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- El pergamino permanece fijo: solo se desplaza su contenido interior.
         El margen interior protege los adornos superiores e inferiores, incluso
         cuando se desplaza la pantalla o se abre un archivo muy largo. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_margin="7dp" android:layout_weight="1" android:background="@drawable/fondo_pergamino" android:clipChildren="true">

        <ScrollView android:id="@+id/scroll_cesar" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="32dp" android:layout_marginBottom="34dp" android:fillViewport="false" android:clipToPadding="true" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="10dp" android:paddingBottom="26dp">
            <ImageView android:layout_width="76dp" android:layout_height="76dp" android:src="@drawable/icon_cesar" android:contentDescription="@string/action_cesar"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="@string/cesar_description" android:textColor="@color/ink" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="──────── ✦ ────────" android:textColor="#AE7D38" android:textSize="17sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:fontFamily="serif" android:text="@string/file_txt" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_file" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp" android:minHeight="72dp">
                <ImageView android:layout_width="35dp" android:layout_height="35dp" android:src="@drawable/icon_archivo" android:contentDescription="@null"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/selected_file" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/file_placeholder" android:textColor="@color/ink" android:textSize="12sp" android:textStyle="bold" android:breakStrategy="high_quality" android:hyphenationFrequency="none" android:paddingTop="2dp"/>
                    <TextView android:id="@+id/file_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TXT · UTF-8" android:textColor="#82664B" android:textSize="11sp"/>
                </LinearLayout>
                <TextView android:id="@+id/btn_browse" android:layout_width="90dp" android:layout_height="44dp" android:background="@drawable/bg_teal_button" android:clickable="true" android:contentDescription="@string/browse" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:text="@string/browse" android:textColor="@color/ivory" android:textSize="14sp"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="─────── ✦ ───────" android:textColor="#AE7D38"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="serif" android:text="@string/shift" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <EditText android:id="@+id/input_shift" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:contentDescription="@string/shift" android:inputType="numberSigned" android:maxLines="1" android:paddingHorizontal="13dp" android:text="3" android:textColor="@color/ink" android:textSize="17sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:fontFamily="serif" android:text="@string/decrypted_text" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/result_text" android:saveEnabled="false" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="5dp" android:background="@drawable/bg_input" android:gravity="top|start" android:padding="13dp" android:scrollbars="vertical" android:fadeScrollbars="false" android:text="@string/result_placeholder" android:textColor="@color/ink" android:textIsSelectable="false" android:textSize="14sp"/>
            <LinearLayout android:id="@+id/btn_decrypt" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_burgundy_button" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" android:orientation="horizontal" android:contentDescription="@string/decipher_cesar">
                <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="8dp" android:src="@drawable/icon_varita" android:contentDescription="@null"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/decipher_cesar" android:textColor="@color/ivory" android:textSize="17sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/btn_share_text" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_outline_button" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/share_text" android:textColor="@color/ink" android:visibility="gone"/>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <include layout="@layout/view_bottom_nav"/>
</LinearLayout>
