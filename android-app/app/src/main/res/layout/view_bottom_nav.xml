<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:background="@drawable/bg_bottom_nav"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/nav_inicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:contentDescription="@string/nav_home">
        <ImageView
            android:id="@+id/nav_inicio_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/icon_inicio"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/nav_inicio_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_home"
            android:textColor="@color/gold"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="38dp"
        android:background="#7D675341" />

    <LinearLayout
        android:id="@+id/nav_ajustes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:contentDescription="@string/nav_settings">
        <ImageView
            android:id="@+id/nav_ajustes_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/icon_ajustes"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/nav_ajustes_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings"
            android:textColor="@color/disabled_rose"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
